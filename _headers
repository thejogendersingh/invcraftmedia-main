# 2. JavaScript & CSS Bundles: Always revalidate so code edits reflect instantly!
/*/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*/*/*.js
  Cache-Control: public, max-age=0, must-revalidate

